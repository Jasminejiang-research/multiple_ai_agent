GEMINI_API_KEY=
TAVILY_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash
LLM_MAX_PROMPT_CHARS=120000
LLM_MAX_OUTPUT_TOKENS_PER_REQUEST=16384
# 6 specialist + 8 Writer + 26 per-section citation repair + 2 critic
# + 8 Revision + 1 revision patch = 51 worst-case requests.
LLM_RUN_MAX_REQUESTS=51
# Covers repeated batch prompts/outputs; a historical full Revision used ~31K.
LLM_RUN_MAX_TOTAL_TOKENS=600000
GEMINI_INPUT_USD_PER_MILLION_TOKENS=0
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=0
