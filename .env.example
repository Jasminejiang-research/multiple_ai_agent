GEMINI_API_KEY=
TAVILY_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash
LLM_MAX_PROMPT_CHARS=120000
LLM_MAX_OUTPUT_TOKENS_PER_REQUEST=16384
# Six Multi-Agent LLM nodes may each need one correction: 6 x 2 = 12 requests.
LLM_RUN_MAX_REQUESTS=12
# Covers the worst-case chain; a historical Revision call used about 31K tokens.
LLM_RUN_MAX_TOTAL_TOKENS=200000
GEMINI_INPUT_USD_PER_MILLION_TOKENS=0
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=0
