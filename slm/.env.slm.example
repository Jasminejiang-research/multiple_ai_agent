# SiliconFlow OpenAI-compatible endpoint (international site).
# China site: https://api.siliconflow.cn/v1
SLM_BASE_URL=https://api.siliconflow.com/v1
SLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# Required. Any OpenAI-compatible provider works; a local server (Ollama, vLLM)
# accepts any non-empty placeholder.
SLM_API_KEY=

SLM_STRUCTURED_MODE=json_object
SLM_MAX_PROMPT_CHARS=90000
SLM_MAX_OUTPUT_TOKENS=8192

# Hosted inference answers in seconds. A local CPU endpoint needs far more:
# one Finance request measured 281s on the reference machine.
SLM_REQUEST_TIMEOUT=300

# Sized for the chunked writer: 8 requests minimum (research, strategy, finance,
# 3 writer batches, critic, revision), 16 if every node needs one correction.
SLM_RUN_MAX_REQUESTS=18
SLM_RUN_MAX_TOTAL_TOKENS=300000

# Verify at startup that the endpoint really serves
# SLM_MAX_PROMPT_CHARS/4 + SLM_MAX_OUTPUT_TOKENS context tokens. A server whose
# window is smaller truncates the prompt silently instead of failing, which
# strips the instruction header out of every request. One probe request, cached
# per base_url + model + requirement; set to 0 only when you accept that risk.
SLM_CONTEXT_PROBE=1

# Generate the multi-agent writer's 13 sections as three smaller requests
# instead of one. Off by default: it changes how the SLM arm writes relative to
# the Gemini arm, which is a Phase 7 comparability decision.
SLM_CHUNKED_WRITER=0

# Ask the SLM for slim schemas (analytical core only) and condensed prompts,
# then expand deterministically to the full strict schemas. Needed by small
# models that degenerate on long structured outputs; changes what the SLM
# arm is asked for relative to the Gemini arm (see slm/pruning.py).
SLM_PRUNED_SCHEMAS=0

# Hosted endpoints only: without these the SLM arm records a cost of zero in
# every run record, which Phase 7 would then compare against the Gemini arm.
SLM_INPUT_USD_PER_MILLION_TOKENS=0.0
SLM_OUTPUT_USD_PER_MILLION_TOKENS=0.0
